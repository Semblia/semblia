{
  "name": "api_v2",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm -w build --filter @workspace/database && nest start --watch --builder swc --type-check",
    "worker:dev": "pnpm -w build --filter @workspace/database && nest start --watch --entryFile worker --builder swc --type-check",
    "build": "nest build",
    "start": "node dist/src/main.js",
    "start:prod": "node dist/src/main.js",
    "worker:start": "node dist/src/worker.js",
    "start:debug": "pnpm -w build --filter @workspace/database && nest start --debug --watch --builder swc --type-check",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"src/**/*.{ts,json,md}\"",
    "format:check": "prettier --check \"src/**/*.{ts,json,md}\"",
    "admin:grant": "tsx scripts/grant-admin.ts",
    "forms:backfill-v4": "tsx scripts/backfill-forms-v4.ts",
    "public-hosting:backfill": "tsx src/scripts/backfill-public-hosting.ts",
    "smoke:start": "node scripts/smoke-start.mjs",
    "smoke:worker": "node scripts/smoke-worker.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-comprehend": "^3.1103.0",
    "@aws-sdk/client-rekognition": "^3.1103.0",
    "@aws-sdk/client-s3": "^3.1103.0",
    "@aws-sdk/client-transcribe": "^3.1103.0",
    "@aws-sdk/s3-request-presigner": "^3.1103.0",
    "@clerk/backend": "^3.15.1",
    "@nestjs/bullmq": "^11.0.4",
    "@nestjs/common": "^11.1.28",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.1.28",
    "@nestjs/platform-express": "^11.1.28",
    "@nestjs/schedule": "^6.1.3",
    "@nestjs/swagger": "11.4.6",
    "@nestjs/throttler": "^6.5.0",
    "@workspace/database": "workspace:*",
    "@workspace/forms-core": "workspace:*",
    "@workspace/types": "workspace:*",
    "@workspace/widgets-core": "workspace:*",
    "bullmq": "^5.81.3",
    "cheerio": "1.2.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "ioredis": "^5.11.1",
    "razorpay": "^2.9.8",
    "reflect-metadata": "^0.2.2",
    "resend": "^6.18.1",
    "rxjs": "^7.8.2",
    "sharp": "0.35.3",
    "svix": "^1.99.1",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.24",
    "@nestjs/testing": "^11.1.28",
    "@swc/cli": "^0.8.1",
    "@swc/core": "^1.15.47",
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.1",
    "@vitest/coverage-v8": "4.1.10",
    "@workspace/eslint-config": "workspace:*",
    "@workspace/typescript-config": "workspace:*",
    "chokidar": "^5.0.0",
    "eslint": "^9.39.5",
    "prettier": "^3.9.6",
    "tsx": "^4.23.7",
    "typescript": "5.9.3",
    "vitest": "^4.1.10"
  }
}
