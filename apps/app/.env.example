# Env contract for the app (app.semblia.com) — the Vercel project must set
# every non-optional key below for Production. NEXT_PUBLIC_* values are
# inlined into client bundles at build time: changing them on Vercel requires
# a redeploy, and a production build FAILS if NEXT_PUBLIC_API_URL is missing
# or malformed (next.config.ts resolveApiOrigin).

# API origin the dashboard talks to. Production: https://api.semblia.com
# The fail-fast triggers when VERCEL_ENV=production: the release workflow
# pins it explicitly; for builds on Vercel's own infrastructure, enable the
# project's "Enable access to System Environment Variables" toggle.
NEXT_PUBLIC_API_URL=http://localhost:8100

# Clerk (customer instance). The publishable key and route URLs are inlined;
# CLERK_SECRET_KEY stays server-side.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/welcome

# Optional: storage origins added to the CSP connect-src for direct browser
# uploads/reads. Mirror of S3_PUBLIC_CDN_BASE_URL / AWS_S3_ENDPOINT in
# apps/api. No trailing slash.
NEXT_PUBLIC_S3_PUBLIC_CDN_BASE_URL=
NEXT_PUBLIC_S3_ENDPOINT=
