{
  "name": "@semblia/embed",
  "version": "0.1.0",
  "private": true,
  "description": "Internal loader that injects and dedupes the Semblia CDN embed scripts. Bundled into @semblia/react; published standalone post-launch.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "dev": "tsc -p tsconfig.json --watch"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "@vitest/coverage-v8": "4.1.10",
    "@workspace/typescript-config": "workspace:*",
    "jsdom": "^30.0.1",
    "typescript": "5.9.3",
    "vitest": "^4.1.10"
  }
}
