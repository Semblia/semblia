{
  "name": "@semblia/react",
  "version": "0.1.0",
  "private": false,
  "description": "React components for embedding Semblia widgets and forms. Thin typed wrappers over the evergreen CDN embed runtime — no rendering logic ships on npm.",
  "license": "MIT",
  "homepage": "https://docs.semblia.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/Semblia/semblia.git",
    "directory": "packages/semblia-react"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json --emitDeclarationOnly && node scripts/bundle.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "dev": "tsc -p tsconfig.json --watch"
  },
  "peerDependencies": {
    "react": "^19"
  },
  "devDependencies": {
    "@semblia/embed": "workspace:*",
    "@types/node": "^22.20.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitest/coverage-v8": "4.1.10",
    "@workspace/typescript-config": "workspace:*",
    "esbuild": "^0.28.1",
    "jsdom": "^30.0.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "typescript": "5.9.3",
    "vitest": "^4.1.10"
  }
}
